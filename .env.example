# Copy to .env (or set these in Render → Environment)
PORT=3000
NODE_ENV=production

# Admin dashboard login (/admin)
ADMIN_PASSWORD=change-me-to-something-long

# Where new leads + Instant Estimate alerts get emailed
NOTIFY_EMAIL=loriaconstruction585@gmail.com

# SMTP (e.g. Gmail app password: smtp.gmail.com / 465 / secure=true)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Loria Construction <loriaconstruction585@gmail.com>"

# Public site URL (used in email links, incl. the customer's "request site visit" link)
SITE_URL=https://www.loriaconstruction.com
